# Values prefixed with EXPO_PUBLIC_ are embedded in the app and are not secrets.
# Never add Supabase secret/service-role keys or Cloudflare R2 credentials here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Build-time Maps SDK keys. App binaries can expose these: use separate OS keys
# with application restrictions and only the corresponding Maps SDK API enabled.
# Changing either key requires a native rebuild; never paste real keys into Git/logs.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
